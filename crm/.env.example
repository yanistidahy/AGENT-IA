# Copier en `.env` pour le développement local. Ne jamais commiter `.env`.

# Base de données.
# Production : URL PostgreSQL fournie par Railway (variable partagée du service Postgres).
# Local      : soit un Postgres local, soit l'URL publique du Postgres Railway.
DATABASE_URL="postgresql://postgres:motdepasse@localhost:5432/auraflow?schema=public"

# Mot de passe unique de l'espace de travail. OBLIGATOIRE.
# Sans lui, l'application refuse tout accès (503) : une variable oubliée doit
# casser visiblement, jamais rouvrir le CRM en silence.
# Générer une valeur aléatoire : openssl rand -base64 24
# Il sert aussi de clé de signature des sessions : le changer déconnecte tout le
# monde — c'est le seul moyen de révoquer un accès sans comptes utilisateurs.
WORKSPACE_PASSWORD=""

# Clé API Anthropic pour le conseil d'agents. Utilisée à partir de la phase 3.
# Console : https://console.anthropic.com/settings/keys
# Elle n'est lue que côté serveur, jamais exposée au navigateur.
ANTHROPIC_API_KEY=""

# Drapeau de fonctionnalité de l'agent Étienne. Utilisé à partir de la phase 4.
AGENT_ETIENNE_ENABLED="false"

# Secret du planificateur de vacations. Distinct du mot de passe d'espace : un
# cron n'est pas un utilisateur, et lui confier la clé de tout le CRM en ferait
# une seconde copie à protéger.
# Générer : openssl rand -hex 32
CRON_SECRET=""

# --- Sauvegardes automatiques -------------------------------------------
# Destination des instantanés. `github` (recommandé) ou `local` (vérification
# seulement : le disque du conteneur est effacé à chaque déploiement).
SNAPSHOT_STORE="github"
# Dépôt PRIVÉ dédié aux sauvegardes, au format "utilisateur/depot".
SNAPSHOT_GITHUB_REPO=""
# Jeton à portée fine, permission « Contents: Read and write » sur ce seul dépôt.
SNAPSHOT_GITHUB_TOKEN=""
# Facultatifs.
SNAPSHOT_GITHUB_BRANCH="main"
SNAPSHOT_GITHUB_DIR="snapshots"

# ── Messagerie sortante (jalon 32) ──────────────────────────────────────────
# Mot de passe SMTP de la boîte IONOS. **Uniquement ici** : il n'est jamais
# écrit en base, jamais renvoyé au navigateur, jamais inclus dans une
# sauvegarde JSON — même discipline que ANTHROPIC_API_KEY.
# Le reste de la configuration (hôte, port, chiffrement, identifiant, adresse
# et nom d'expédition) se règle dans /reglages → Messagerie.
SMTP_PASSWORD=""

# ── Synchronisation lemlist (jalon 111) ─────────────────────────────────────
# Clé de l'API lemlist. **Uniquement ici** : elle n'est jamais écrite en base,
# jamais renvoyée par une route, jamais affichée à l'écran, jamais incluse dans
# une sauvegarde JSON — même discipline que SMTP_PASSWORD et ANTHROPIC_API_KEY.
# Un seul module la lit : lib/api/lemlist-client.ts, et un test le vérifie.
# Absente, /reglages affiche « clé absente » et rien ne casse.
LEMLIST_API_KEY=""
# Mot de passe partagé du webhook lemlist, comparé à temps constant. À générer
# avec `openssl rand -hex 32`, puis à passer **tel quel** dans le champ `secret`
# de POST /api/hooks côté lemlist. Absent, la route répond 401 et n'écrit rien.
# Immuable côté lemlist : pour le changer, supprimer le webhook et le recréer.
LEMLIST_WEBHOOK_SECRET=""

# ── Abonnements mensuels Mollie (jalon 115) ─────────────────────────────────
# Clé de l'API Mollie. **Uniquement ici** : jamais en base, jamais renvoyée par
# une route, jamais affichée, jamais dans une sauvegarde — même discipline que
# LEMLIST_API_KEY. Un seul module la lit : lib/api/mollie-client.ts, et un test
# le vérifie. Absente, la fiche société refuse de générer un lien et le dit.
# C'est la clé qui choisit le mode : `test_…` = paiements factices (cartes de
# test Mollie), `live_…` = vrais prélèvements. Commencer par `test_…`, et ne
# jamais coller une clé `live_…` dans un message ou un ticket.
MOLLIE_API_KEY=""
# Joint de vérification : remplace la racine de l'API Mollie par un substitut
# local. **Vide en production**, et c'est le cas normal.
MOLLIE_BASE_URL=""
# Les liens de paiement et le webhook Mollie ont besoin de l'adresse publique du
# CRM : CRM_PUBLIC_URL (ou, à défaut, RAILWAY_PUBLIC_DOMAIN) doit être posée.
