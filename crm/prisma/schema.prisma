// AuraFLOW CRM — schéma de données
//
// Portabilité : aucun `enum` Prisma, aucun tableau scalaire, aucun `Json`.
// Ces trois constructions ne sont pas supportées de façon identique par les
// connecteurs SQLite et PostgreSQL. Les valeurs contraintes sont stockées en
// `String` et validées à la frontière par les `z.enum()` de lib/domain/schemas.ts.
// Basculer SQLite <-> PostgreSQL ne demande donc que de changer `provider`
// et `DATABASE_URL`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Étape du pipeline. `prob` est la probabilité par défaut des affaires de
/// l'étape ; `prob >= 100` marque l'étape terminale « Gagné ».
model Stage {
  id       String @id @default(cuid())
  name     String
  color    String
  prob     Int
  position Int    @unique

  /// Action de suivi proposée quand une affaire entre dans cette étape.
  /// Vide = aucune proposition. Configurable dans /reglages.
  nextActionLabel String @default("")
  nextActionDays  Int    @default(3)

  deals Deal[]

  @@map("stages")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  domain    String   @default("")
  size      String   @default("")
  industry  String   @default("")
  loc       String   @default("")
  desc      String   @default("")
  createdAt DateTime @default(now())

  /// Miroir normalisé (minuscules, sans accents) des champs cherchables.
  /// Écrit par l'application à chaque écriture — voir lib/domain/text.ts.
  /// Permet à « zenith » de trouver « Zénith » sans extension PostgreSQL.
  searchText String @default("")

  contacts   Contact[]
  deals      Deal[]
  activities Activity[]
  tasks      Task[]

  @@index([name])
  @@map("companies")
}

/// `lifecycle` : Lead | Prospect | Client | Ancien Client | Perdu
/// `Perdu` parque un prospect qui a dit non sans effacer son historique.
model Contact {
  id           String    @id @default(cuid())
  firstName    String
  lastName     String
  title        String    @default("")
  dep          String    @default("")
  email        String    @default("")
  phone        String    @default("")
  linkedin     String    @default("")
  lifecycle    String
  source       String    @default("")
  owner        String    @default("")
  lastContact  DateTime?
  nextReminder DateTime?
  notes        String    @default("")
  createdAt    DateTime  @default(now())

  /// Étiquette libre, choisie ou créée depuis le formulaire. Vide = sans étiquette.
  tag String @default("")

  /// Motif de perte, renseigné quand `lifecycle` vaut « Perdu ». Champ libre :
  /// une raison qu'on n'avait pas prévue est justement celle qu'il faut écrire.
  /// La valeur « Ne souhaite plus être contacté » vaut opposition au démarchage
  /// et est appliquée dans lib/domain/lost.ts, quel que soit le cycle de vie.
  lostReason String @default("")

  /// Statut de relance **saisi**, qui l'emporte sur le statut calculé quand il
  /// est renseigné. Vide = on retombe sur le calcul (lib/domain/follow-up.ts),
  /// ce qui laisse les fiches importées inchangées tant qu'on ne les touche pas.
  /// Champ libre : la liste proposée n'est qu'une liste de suggestions.
  status      String    @default("")
  /// Quand le statut saisi a été posé. Sert à repérer un statut figé : une fiche
  /// dont le statut n'a pas bougé alors qu'une interaction plus récente existe.
  statusSetAt DateTime?

  /// Miroir normalisé des champs cherchables — voir Company.searchText.
  searchText String @default("")

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  deals      Deal[]
  activities Activity[]
  tasks      Task[]

  @@index([companyId])
  @@index([lifecycle])
  @@index([tag])
  @@map("contacts")
}

/// `status` : open | won | lost
/// `prob` surcharge la probabilité de l'étape quand elle est renseignée.
/// `lastActivityAt` pilote la chaleur de l'affaire (active / tiède / froide).
model Deal {
  id             String    @id @default(cuid())
  name           String
  amount         Int       @default(0)
  owner          String
  offer          String    @default("")
  status         String    @default("open")
  prob           Int?
  notes          String    @default("")
  expectedClose  DateTime?
  lastActivityAt DateTime?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  /// Entrée dans l'étape courante. Distinct de `lastActivityAt` : une affaire
  /// peut être touchée sans changer d'étape, et c'est l'ancienneté *dans
  /// l'étape* qui dit si elle stagne à un endroit précis du pipeline.
  stageSince     DateTime?

  /// Miroir normalisé des champs cherchables — voir Company.searchText.
  searchText String @default("")

  stageId String
  stage   Stage  @relation(fields: [stageId], references: [id])

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  activities    Activity[]
  tasks         Task[]
  conversations Conversation[]

  @@index([stageId])
  @@index([companyId])
  @@index([contactId])
  @@index([status])
  @@map("deals")
}

/// Conversation avec un agent du conseil.
/// `agentId` référence lib/agents/registry.ts, pas une table — les agents sont
/// du code versionné, pas de la donnée éditable.
model Conversation {
  id        String   @id @default(cuid())
  agentId   String
  title     String
  /// « Mode approfondi » : relève l'effort de raisonnement, pas le plafond de sortie.
  deep      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  messages Message[]

  @@index([updatedAt])
  @@index([dealId])
  @@map("conversations")
}

/// `role` : user | assistant | tool
/// `content` porte les blocs Anthropic sérialisés en JSON (texte, tool_use,
/// tool_result). Stocké en `String` plutôt qu'en `Json` pour la même raison de
/// portabilité que le reste du schéma ; relu via Zod dans lib/agents/messages.ts.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// `type` : call | email | meeting | demo | note
/// `outcome` : issue de l'échange, saisie au moment de consigner l'interaction.
/// C'est elle qui propose le statut du contact — voir lib/domain/status.ts.
model Activity {
  id        String   @id @default(cuid())
  type      String
  date      DateTime
  owner     String
  notes     String   @default("")
  duration  Int?
  createdAt DateTime @default(now())

  /// Issue de l'échange, saisie au moment de consigner. Vide pour les
  /// interactions antérieures à ce champ.
  outcome String @default("")

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([contactId])
  @@index([dealId])
  @@index([companyId])
  @@index([date])
  @@map("activities")
}

/// `priority` : haute | normale | basse
/// Le couple polymorphe `relType`/`relId` du prototype est remplacé par trois
/// clés étrangères nullables : l'intégrité référentielle est ainsi garantie par
/// la base, et les jointures Prisma deviennent possibles. Au plus une des trois
/// est renseignée ; `taskTarget()` dans lib/domain/tasks.ts fait la lecture.
/// `auto` marque les tâches créées par une règle d'automatisation plutôt que
/// par une saisie. `autoKey` porte l'identité de la règle et de sa cible
/// (« reminder:<contactId> ») : son unicité *est* le garde-fou anti-doublon —
/// rejouer le même déclencheur ne peut pas créer une seconde tâche, la base le
/// refuse. Voir lib/domain/automation.ts.
model Task {
  id        String    @id @default(cuid())
  title     String
  due       DateTime
  priority  String    @default("normale")
  owner     String
  done      Boolean   @default(false)
  doneAt    DateTime?
  createdAt DateTime  @default(now())
  auto      Boolean   @default(false)
  autoKey   String?   @unique

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([done, due])
  @@index([owner])
  @@map("tasks")
}

/// Réglages scalaires. Ligne unique, `id = "singleton"`.
model Settings {
  id              String   @id @default("singleton")
  staleDays       Int      @default(7)
  coldDays        Int      @default(14)
  objectifMensuel Int      @default(15000)
  notifs          Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  /// Délais de relance proposés après une interaction, par type. Ce sont des
  /// propositions pré-remplies dans le formulaire, jamais des écritures muettes.
  relanceApresAppel   Int @default(7)
  relanceApresEmail   Int @default(4)
  relanceApresDemo    Int @default(2)
  relanceApresReunion Int @default(3)
  relanceApresNote    Int @default(7)

  /// Plafond de jetons de sortie par vacation. Bas par défaut : une vacation qui
  /// dépasserait s'arrête et le dit, plutôt que de faire monter la facture.
  shiftTokenBudget Int @default(4000)

  @@map("settings")
}

/// Listes éditables des réglages, en table plutôt qu'en tableau scalaire.
/// `kind` : owners | offers | sources | lifecycles
model SettingsList {
  id       String @id @default(cuid())
  kind     String
  value    String
  position Int

  @@unique([kind, value])
  @@index([kind, position])
  @@map("settings_lists")
}

model Sequence {
  id      String  @id @default(cuid())
  name    String
  trigger String
  active  Boolean @default(true)

  steps SequenceStep[]

  @@map("sequences")
}

/// `channel` : email | call | linkedin
/// `day` est le décalage en jours depuis le déclenchement de la séquence.
model SequenceStep {
  id       String @id @default(cuid())
  day      Int
  channel  String
  label    String
  position Int

  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([sequenceId, position])
  @@map("sequence_steps")
}

/// Recommandation produite par un agent pendant sa vacation.
///
/// `evidence` et `proposedActions` sont stockés en JSON **sérialisé dans une
/// chaîne** : le schéma s'interdit le type `Json` (voir en-tête). La forme est
/// validée par Zod à l'écriture comme à la lecture — la base ne garantit ici que
/// la présence, pas la structure.
model Recommendation {
  id        String   @id @default(cuid())
  agentId   String
  createdAt DateTime @default(now())
  /// info | attention | urgent
  severity  String
  title     String
  rationale String   @default("")
  /// JSON : [{ type: "contact" | "deal" | "company" | "task", id, label }]
  evidence  String   @default("[]")
  /// JSON : [{ tool, input, summary }] — exécutés seulement après confirmation.
  actions   String   @default("[]")
  /// new | accepted | dismissed | snoozed | expired
  status    String   @default("new")

  /// Identité du constat. Son unicité empêche la même trouvaille de revenir à
  /// chaque run — c'est la contrainte de base qui protège, pas une vérification.
  dedupeKey String @unique

  snoozedUntil  DateTime?
  /// Fenêtre pendant laquelle un constat écarté ne revient pas.
  mutedUntil    DateTime?
  /// Pas pertinent | Déjà traité | Plus tard — sert à améliorer les prompts.
  dismissReason String    @default("")
  decidedAt     DateTime?

  runId String?
  run   ShiftRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([agentId])
  @@map("recommendations")
}

/// Trace d'une vacation. Écrite même — surtout — quand elle échoue.
model ShiftRun {
  id           String   @id @default(cuid())
  agentId      String
  startedAt    DateTime @default(now())
  /// Durée en millisecondes. `null` tant que le run n'est pas terminé.
  durationMs   Int?
  /// ok | empty | skipped | error
  outcome      String   @default("ok")
  /// Message d'échec ou raison du saut, en français, sans trace d'exécution.
  detail       String   @default("")
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  produced     Int      @default(0)
  /// Déclenché à la main depuis /reglages plutôt que par le cron.
  manual       Boolean  @default(false)

  recommendations Recommendation[]

  @@index([startedAt])
  @@map("shift_runs")
}

/// Identité d'un agent du conseil.
///
/// L'identité est de la **donnée réglable** ; la personnalité, les outils et le
/// verrou restent du code, indexés par `slug`. Renommer un agent ne peut donc
/// pas changer son comportement : le prompt est retrouvé par le slug, jamais
/// par le nom affiché.
model Agent {
  /// Stable, jamais modifiable depuis l'écran : c'est la clé du prompt.
  slug         String  @id
  name         String
  /// La ligne affichée sous le nom — « Sales & Closing ».
  role         String  @default("")
  enabled      Boolean @default(true)
  /// Ordre d'affichage dans le conseil.
  order        Int     @default(0)
  /// none | daily | weekly — cadence de vacation.
  shiftCadence String  @default("none")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photo AgentPhoto?

  @@map("agents")
}

/// Portrait d'un agent, stocké en base.
///
/// Table séparée **volontairement** : les octets pèsent des centaines de
/// kilo-octets et le conseil se liste à chaque rendu de `/conseil`. Les garder
/// dans `Agent` ferait remonter les portraits à chaque `findMany`, y compris
/// là où personne ne les affiche. Ici, seule la route qui sert l'image les lit.
///
/// Le disque du conteneur Railway est effacé à chaque déploiement : un fichier
/// écrit à côté ne survivrait pas. PostgreSQL est le seul stockage durable dont
/// dispose ce projet, et huit portraits n'y pèsent rien.
model AgentPhoto {
  slug  String @id
  agent Agent  @relation(fields: [slug], references: [slug], onDelete: Cascade)

  /// Type MIME du fichier d'origine, conservé pour la traçabilité.
  sourceMime   String
  /// Deux tailles, deux encodages : WebP d'abord, JPEG en repli.
  portraitWebp Bytes
  portraitJpeg Bytes
  thumbWebp    Bytes
  thumbJpeg    Bytes

  /// Empreinte du fichier d'origine. Sert d'ETag et de jeton de cache.
  version   String
  updatedAt DateTime @updatedAt

  @@map("agent_photos")
}
