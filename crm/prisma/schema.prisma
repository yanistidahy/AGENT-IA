// AuraFLOW CRM — schéma de données
//
// Portabilité : aucun `enum` Prisma, aucun tableau scalaire, aucun `Json`.
// Ces trois constructions ne sont pas supportées de façon identique par les
// connecteurs SQLite et PostgreSQL. Les valeurs contraintes sont stockées en
// `String` et validées à la frontière par les `z.enum()` de lib/domain/schemas.ts.
// Basculer SQLite <-> PostgreSQL ne demande donc que de changer `provider`
// et `DATABASE_URL`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Étape du pipeline. `prob` est la probabilité par défaut des affaires de
/// l'étape ; `prob >= 100` marque l'étape terminale « Gagné ».
model Stage {
  id       String @id @default(cuid())
  name     String
  color    String
  prob     Int
  position Int    @unique

  /// Action de suivi proposée quand une affaire entre dans cette étape.
  /// Vide = aucune proposition. Configurable dans /reglages.
  nextActionLabel String @default("")
  nextActionDays  Int    @default(3)

  /// Critère de sortie, écrit du point de vue de **l'engagement de l'acheteur**
  /// et non de notre activité : « a demandé une proposition » plutôt que
  /// « proposition envoyée ». Une étape définie par ce qu'on a fait se franchit
  /// toute seule ; définie par ce que l'autre a accordé, elle mesure quelque
  /// chose. Affiché au survol de la colonne.
  exitCriterion String @default("")

  deals      Deal[]
  stageVisits DealStageVisit[]

  @@map("stages")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  domain    String   @default("")
  size      String   @default("")
  industry  String   @default("")
  loc       String   @default("")
  desc      String   @default("")
  createdAt DateTime @default(now())

  /// Miroir normalisé (minuscules, sans accents) des champs cherchables.
  /// Écrit par l'application à chaque écriture — voir lib/domain/text.ts.
  /// Permet à « zenith » de trouver « Zénith » sans extension PostgreSQL.
  searchText String @default("")

  contacts   Contact[]
  deals      Deal[]
  activities Activity[]
  tasks      Task[]

  domainRejection DomainRejection?

  @@index([name])
  @@map("companies")
}

/// Proposition de domaine écartée à la main.
///
/// Seuls les **refus** sont stockés : une proposition acceptée écrit le domaine
/// de la société, et disparaît d'elle-même de la liste — celle-ci ne montre que
/// les sociétés au domaine vide. Sans cette table, une proposition rejetée
/// reviendrait à chaque relecture, et la liste ne se viderait jamais.
model DomainRejection {
  id         String   @id @default(cuid())
  companyId  String   @unique
  /// La valeur refusée, conservée pour ne pas la reproposer à l'identique.
  proposed   String
  rejectedAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("domain_rejections")
}

/// `lifecycle` : Lead | Prospect | Client | Ancien Client | Perdu
/// `Perdu` parque un prospect qui a dit non sans effacer son historique.
model Contact {
  id           String    @id @default(cuid())
  firstName    String
  lastName     String
  title        String    @default("")
  dep          String    @default("")
  email        String    @default("")
  phone        String    @default("")
  linkedin     String    @default("")
  lifecycle    String
  source       String    @default("")
  owner        String    @default("")
  lastContact  DateTime?
  nextReminder DateTime?
  notes        String    @default("")
  createdAt    DateTime  @default(now())

  /// Étiquette libre, choisie ou créée depuis le formulaire. Vide = sans étiquette.
  tag String @default("")

  /// Motif de perte, renseigné quand `lifecycle` vaut « Perdu ». Champ libre :
  /// une raison qu'on n'avait pas prévue est justement celle qu'il faut écrire.
  /// La valeur « Ne souhaite plus être contacté » vaut opposition au démarchage
  /// et est appliquée dans lib/domain/lost.ts, quel que soit le cycle de vie.
  lostReason String @default("")

  /// Statut de relance **saisi**, qui l'emporte sur le statut calculé quand il
  /// est renseigné. Vide = on retombe sur le calcul (lib/domain/follow-up.ts),
  /// ce qui laisse les fiches importées inchangées tant qu'on ne les touche pas.
  /// Champ libre : la liste proposée n'est qu'une liste de suggestions.
  status      String    @default("")
  /// Quand le statut saisi a été posé. Sert à repérer un statut figé : une fiche
  /// dont le statut n'a pas bougé alors qu'une interaction plus récente existe.
  statusSetAt DateTime?

  /// Site de la personne ou de sa boutique. Rendu comme un lien, jamais
  /// réécrit en base — voir lib/domain/links.ts.
  website String @default("")

  /// Miroir normalisé des champs cherchables — voir Company.searchText.
  searchText String @default("")

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  /// Compteurs d'emails, **dénormalisés à l'envoi**.
  ///
  /// Un agrégat calculé à la lecture ne se trie pas en SQL : les colonnes
  /// « Emails envoyés » et « Dernier email » de /contacts doivent être
  /// triables, et promettre un tri qui ne trierait rien serait pire que ne rien
  /// promettre (jalon 22). Ils sont écrits dans la même transaction que
  /// l'enregistrement de l'envoi, donc ils ne peuvent pas dériver de `emailSends`.
  emailCount  Int       @default(0)
  lastEmailAt DateTime?

  deals      Deal[]
  activities Activity[]
  tasks       Task[]
  emailSends  EmailSend[]
  enrollments SequenceEnrollment[]

  @@index([companyId])
  @@index([lifecycle])
  @@index([tag])
  @@map("contacts")
}

/// `status` : open | won | lost
/// `prob` surcharge la probabilité de l'étape quand elle est renseignée.
/// `lastActivityAt` pilote la chaleur de l'affaire (active / tiède / froide).
model Deal {
  id             String    @id @default(cuid())
  name           String
  amount         Int       @default(0)
  owner          String
  offer          String    @default("")
  status         String    @default("open")
  prob           Int?
  notes          String    @default("")
  expectedClose  DateTime?
  lastActivityAt DateTime?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  /// Entrée dans l'étape courante. Distinct de `lastActivityAt` : une affaire
  /// peut être touchée sans changer d'étape, et c'est l'ancienneté *dans
  /// l'étape* qui dit si elle stagne à un endroit précis du pipeline.
  stageSince     DateTime?

  /// Miroir normalisé des champs cherchables — voir Company.searchText.
  searchText String @default("")

  stageId String
  stage   Stage  @relation(fields: [stageId], references: [id])

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  activities    Activity[]
  tasks         Task[]
  stageVisits   DealStageVisit[]
  conversations Conversation[]

  @@index([stageId])
  @@index([companyId])
  @@index([contactId])
  @@index([status])
  @@map("deals")
}

/// Conversation avec un agent du conseil.
/// `agentId` référence lib/agents/registry.ts, pas une table — les agents sont
/// du code versionné, pas de la donnée éditable.
model Conversation {
  id        String   @id @default(cuid())
  agentId   String
  title     String
  /// « Mode approfondi » : relève l'effort de raisonnement, pas le plafond de sortie.
  deep      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  messages Message[]

  @@index([updatedAt])
  @@index([dealId])
  @@map("conversations")
}

/// `role` : user | assistant | tool
/// `content` porte les blocs Anthropic sérialisés en JSON (texte, tool_use,
/// tool_result). Stocké en `String` plutôt qu'en `Json` pour la même raison de
/// portabilité que le reste du schéma ; relu via Zod dans lib/agents/messages.ts.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// `type` : call | email | meeting | demo | note
/// `outcome` : issue de l'échange, saisie au moment de consigner l'interaction.
/// C'est elle qui propose le statut du contact — voir lib/domain/status.ts.
model Activity {
  id        String   @id @default(cuid())
  type      String
  date      DateTime
  owner     String
  notes     String   @default("")
  duration  Int?
  createdAt DateTime @default(now())

  /// Issue de l'échange, saisie au moment de consigner. Vide pour les
  /// interactions antérieures à ce champ.
  outcome String @default("")

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([contactId])
  @@index([dealId])
  @@index([companyId])
  @@index([date])
  @@map("activities")
}

/// `priority` : haute | normale | basse
/// Le couple polymorphe `relType`/`relId` du prototype est remplacé par trois
/// clés étrangères nullables : l'intégrité référentielle est ainsi garantie par
/// la base, et les jointures Prisma deviennent possibles. Au plus une des trois
/// est renseignée ; `taskTarget()` dans lib/domain/tasks.ts fait la lecture.
/// `auto` marque les tâches créées par une règle d'automatisation plutôt que
/// par une saisie. `autoKey` porte l'identité de la règle et de sa cible
/// (« reminder:<contactId> ») : son unicité *est* le garde-fou anti-doublon —
/// rejouer le même déclencheur ne peut pas créer une seconde tâche, la base le
/// refuse. Voir lib/domain/automation.ts.
model Task {
  id        String    @id @default(cuid())
  title     String
  due       DateTime
  priority  String    @default("normale")
  owner     String
  done      Boolean   @default(false)
  doneAt    DateTime?
  createdAt DateTime  @default(now())
  auto      Boolean   @default(false)
  autoKey   String?   @unique

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([done, due])
  @@index([owner])
  @@map("tasks")
}

/// Réglages scalaires. Ligne unique, `id = "singleton"`.
model Settings {
  id              String   @id @default("singleton")
  staleDays       Int      @default(7)
  coldDays        Int      @default(14)
  objectifMensuel Int      @default(15000)
  notifs          Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  /// Délais de relance proposés après une interaction, par type. Ce sont des
  /// propositions pré-remplies dans le formulaire, jamais des écritures muettes.
  relanceApresAppel   Int @default(7)
  relanceApresEmail   Int @default(4)
  relanceApresDemo    Int @default(2)
  relanceApresReunion Int @default(3)
  relanceApresNote    Int @default(7)

  /// Plafond de jetons de sortie par vacation. Bas par défaut : une vacation qui
  /// dépasserait s'arrête et le dit, plutôt que de faire monter la facture.
  shiftTokenBudget Int @default(4000)

  /// Messagerie sortante (SMTP).
  ///
  /// **Le mot de passe n'est pas ici, et ce n'est pas un oubli.** Il vit dans la
  /// variable d'environnement `SMTP_PASSWORD`, comme `ANTHROPIC_API_KEY` : une
  /// sauvegarde JSON, un export ou une lecture de table ne doivent jamais le
  /// contenir. Ce qui est ci-dessous est de la configuration, pas un secret.
  smtpHost       String  @default("")
  smtpPort       Int     @default(587)
  /// tls | starttls — `tls` pour le port 465, `starttls` pour le 587.
  smtpEncryption String  @default("starttls")
  smtpUser       String  @default("")
  smtpFrom       String  @default("")
  smtpFromName   String  @default("")

  /// Signature par défaut, conservée pour les bases antérieures au jalon 35.
  ///
  /// La liste des signataires vit désormais dans `signatories` : deux personnes
  /// envoient depuis ce CRM, et un couple unique ne pouvait en décrire qu'une.
  /// Ces deux colonnes ne sont plus lues — elles restent pour que la migration
  /// puisse semer le premier signataire depuis ce qui était réglé.
  signName  String @default("Yanis Tidahy")
  signTitle String @default("Fondateur, Aura Flow AI")

  /// Lien de démonstration proposé dans le corps du message.
  ///
  /// `demoUrl` vide **supprime la phrase entière** plutôt que d'écrire un lien
  /// mort : un lien qui ne mène nulle part dans un premier contact coûte plus
  /// que l'absence de lien.
  demoLabel String @default("Diagnostic offert")
  demoUrl   String @default("https://deluxe-fudge-addd15.netlify.app/")

  /// Un modèle par usage, plutôt qu'un modèle pour tout.
  ///
  /// Rédiger un email à partir d'un dossier fourni n'est pas la même tâche que
  /// juger un briefing : les payer au même tarif, c'est payer le plus fort des
  /// deux pour les deux. Les valeurs sont validées contre `MODELS` — un
  /// identifiant inconnu serait un 400 à chaque appel, pas un réglage.
  modelDraft    String @default("claude-sonnet-5")
  modelRevision String @default("claude-sonnet-5")
  modelChat     String @default("claude-sonnet-5")
  modelShift    String @default("claude-opus-5")

  /// Réception IMAP — **uniquement pour déposer une copie dans « Envoyés »**.
  ///
  /// Ni identifiant ni mot de passe ici : ce sont ceux du SMTP. Deux jeux
  /// d'identifiants pour la même boîte, ce serait deux occasions de se tromper
  /// et un secret de plus à ne pas laisser fuir.
  ///
  /// `imapSentMailbox` n'est qu'un **repli** : le dossier se cherche par son
  /// drapeau special-use `\\Sent`, parce qu'il s'appelle « Sent », « Envoyés »
  /// ou « INBOX.Sent » selon le serveur et la langue du compte.
  imapHost        String  @default("")
  imapPort        Int     @default(993)
  /// tls | starttls — `tls` pour le port 993, `starttls` pour le 143.
  imapEncryption  String  @default("tls")
  imapSentMailbox String  @default("")
  imapCopyEnabled Boolean @default(true)

  /// Suivi d'ouverture — interrupteur global.
  ///
  /// Coupé, aucun pixel n'est posé et aucun jeton n'est émis. C'est un
  /// interrupteur, pas un masquage d'affichage : un pixel posé mais non compté
  /// coûterait la délivrabilité sans rien rapporter.
  trackOpens Boolean @default(true)

  /// Durée de conservation des ouvertures, en mois.
  ///
  /// Une ouverture est une donnée de comportement : le RGPD ne tolère pas
  /// qu'on la garde indéfiniment. L'envoi, lui, est un fait de gestion et
  /// reste — c'est la purge des jetons et des horodatages qui est planifiée.
  openRetentionMonths Int @default(12)

  /// Plafonds d'envoi, volontairement bas au départ.
  ///
  /// **Le serveur connaît la vraie limite ; ces valeurs ne sont qu'une
  /// estimation prudente en attendant qu'il parle.** Un `450 Mail send limit
  /// exceeded` d'IONOS abaisse `sendPerHour` à ce qui vient réellement de
  /// passer, et le dit sur l'accueil — voir `sendLimitNotice`.
  sendPerHour Int @default(30)
  sendPerDay  Int @default(150)

  /// Ce que le serveur d'envoi a opposé, en français, pour le bandeau d'accueil.
  /// Vide = rien à signaler. Effacé quand on relève le plafond à la main.
  sendLimitNotice   String    @default("")
  sendLimitNoticeAt DateTime?

  /// Dernier passage quotidien **réussi**.
  ///
  /// Un planificateur qui s'arrête en silence est pire que pas de
  /// planificateur : on croit ses relances parties alors que rien ne bouge. Le
  /// journal ne peut montrer que les passages qui ont eu lieu ; c'est donc
  /// l'absence de passage qu'il faut rendre visible, et il n'y a qu'un
  /// horodatage à tenir pour cela.
  lastCronAt DateTime?

  /// Plafond de dépense mensuelle, en cents. `0` désactive le plafond.
  ///
  /// En cents et non en micro-dollars : c'est un montant qu'on saisit à
  /// l'écran, pas une somme qu'on accumule. L'accumulation, elle, se fait en
  /// micro-dollars dans `api_usage`.
  monthlyBudgetCents Int @default(2000)

  @@map("settings")
}

/// Ce qu'a coûté chaque appel au modèle.
///
/// **Une ligne par requête, écrite après la réponse.** Mesurer d'abord et
/// couper ensuite : sans cette table, toute réduction de coût serait une
/// conviction, et l'on ne saurait pas davantage après qu'avant si elle a servi.
///
/// Les jetons de réflexion ne sont pas un troisième terme du coût : ils font
/// partie de la sortie et sont facturés comme elle. `thinkingTokens` reste donc
/// nullable — `null` veut dire « non ventilé par l'API », ce qui est le cas dès
/// que la réflexion n'est pas renvoyée en résumé.
model ApiUsage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  /// `YYYY-MM-DD` dans le fuseau du serveur — pour grouper par jour sans
  /// dépendre du fuseau de celui qui lit.
  day       String
  /// `YYYY-MM`, la fenêtre du plafond mensuel.
  month     String

  agentId String
  /// draft | revision | chat | shift
  purpose String
  model   String

  inputTokens      Int  @default(0)
  outputTokens     Int  @default(0)
  thinkingTokens   Int?
  cacheReadTokens  Int  @default(0)
  cacheWriteTokens Int  @default(0)

  /// Coût en micro-dollars entiers. Une somme de flottants dérive sur un mois.
  costMicros Int @default(0)

  /// L'appel a coûté un multiple de ce que son usage coûte d'ordinaire.
  anomaly Boolean @default(false)
  detail  String  @default("")

  @@index([month])
  @@index([day])
  @@index([agentId])
  @@index([purpose])
  @@map("api_usage")
}

/// Listes éditables des réglages, en table plutôt qu'en tableau scalaire.
/// `kind` : owners | offers | sources | lifecycles
model SettingsList {
  id       String @id @default(cuid())
  kind     String
  value    String
  position Int

  @@unique([kind, value])
  @@index([kind, position])
  @@map("settings_lists")
}

model Sequence {
  id      String  @id @default(cuid())
  name    String
  trigger String
  active  Boolean @default(true)

  steps SequenceStep[]

  @@map("sequences")
}

/// `channel` : email | call | linkedin
/// `day` est le décalage en jours depuis le déclenchement de la séquence.
model SequenceStep {
  id       String @id @default(cuid())
  day      Int
  channel  String
  label    String
  position Int

  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([sequenceId, position])
  @@map("sequence_steps")
}

/// Recommandation produite par un agent pendant sa vacation.
///
/// `evidence` et `proposedActions` sont stockés en JSON **sérialisé dans une
/// chaîne** : le schéma s'interdit le type `Json` (voir en-tête). La forme est
/// validée par Zod à l'écriture comme à la lecture — la base ne garantit ici que
/// la présence, pas la structure.
model Recommendation {
  id        String   @id @default(cuid())
  agentId   String
  createdAt DateTime @default(now())
  /// info | attention | urgent
  severity  String
  title     String
  rationale String   @default("")
  /// JSON : [{ type: "contact" | "deal" | "company" | "task", id, label }]
  evidence  String   @default("[]")
  /// JSON : [{ tool, input, summary }] — exécutés seulement après confirmation.
  actions   String   @default("[]")
  /// new | accepted | dismissed | snoozed | expired
  status    String   @default("new")

  /// Identité du constat. Son unicité empêche la même trouvaille de revenir à
  /// chaque run — c'est la contrainte de base qui protège, pas une vérification.
  dedupeKey String @unique

  snoozedUntil  DateTime?
  /// Fenêtre pendant laquelle un constat écarté ne revient pas.
  mutedUntil    DateTime?
  /// Pas pertinent | Déjà traité | Plus tard — sert à améliorer les prompts.
  dismissReason String    @default("")
  decidedAt     DateTime?

  runId String?
  run   ShiftRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([agentId])
  @@map("recommendations")
}

/// Trace d'une vacation. Écrite même — surtout — quand elle échoue.
model ShiftRun {
  id           String   @id @default(cuid())
  agentId      String
  startedAt    DateTime @default(now())
  /// Durée en millisecondes. `null` tant que le run n'est pas terminé.
  durationMs   Int?
  /// ok | empty | skipped | error
  outcome      String   @default("ok")
  /// Message d'échec ou raison du saut, en français, sans trace d'exécution.
  detail       String   @default("")
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  produced     Int      @default(0)
  /// Déclenché à la main depuis /reglages plutôt que par le cron.
  manual       Boolean  @default(false)

  recommendations Recommendation[]

  @@index([startedAt])
  @@map("shift_runs")
}

/// Identité d'un agent du conseil.
///
/// L'identité est de la **donnée réglable** ; la personnalité, les outils et le
/// verrou restent du code, indexés par `slug`. Renommer un agent ne peut donc
/// pas changer son comportement : le prompt est retrouvé par le slug, jamais
/// par le nom affiché.
model Agent {
  /// Stable, jamais modifiable depuis l'écran : c'est la clé du prompt.
  slug         String  @id
  name         String
  /// La ligne affichée sous le nom — « Sales & Closing ».
  role         String  @default("")
  enabled      Boolean @default(true)
  /// Ordre d'affichage dans le conseil.
  order        Int     @default(0)
  /// none | daily | weekly — cadence de vacation.
  shiftCadence String  @default("none")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photo AgentPhoto?

  @@map("agents")
}

/// Portrait d'un agent, stocké en base.
///
/// Table séparée **volontairement** : les octets pèsent des centaines de
/// kilo-octets et le conseil se liste à chaque rendu de `/conseil`. Les garder
/// dans `Agent` ferait remonter les portraits à chaque `findMany`, y compris
/// là où personne ne les affiche. Ici, seule la route qui sert l'image les lit.
///
/// Le disque du conteneur Railway est effacé à chaque déploiement : un fichier
/// écrit à côté ne survivrait pas. PostgreSQL est le seul stockage durable dont
/// dispose ce projet, et huit portraits n'y pèsent rien.
model AgentPhoto {
  slug  String @id
  agent Agent  @relation(fields: [slug], references: [slug], onDelete: Cascade)

  /// Type MIME du fichier d'origine, conservé pour la traçabilité.
  sourceMime   String
  /// Deux tailles, deux encodages : WebP d'abord, JPEG en repli.
  portraitWebp Bytes
  portraitJpeg Bytes
  thumbWebp    Bytes
  thumbJpeg    Bytes

  /// Empreinte du fichier d'origine. Sert d'ETag et de jeton de cache.
  version   String
  updatedAt DateTime @updatedAt

  @@map("agent_photos")
}

/// Trace d'une sauvegarde. Écrite même — surtout — quand elle échoue.
///
/// Le bandeau d'alerte de `/accueil` lit cette table et non le magasin
/// distant : une lecture réseau à chaque rendu de la page d'accueil serait
/// payée par l'utilisateur à chaque visite, pour une information qui change
/// une fois par jour. Le magasin reste la source de vérité pour *restaurer* ;
/// cette table dit seulement « la dernière a-t-elle réussi, et quand ».
model SnapshotRun {
  id         String   @id @default(cuid())
  startedAt  DateTime @default(now())
  /// ok | error
  outcome    String   @default("ok")
  /// Clé écrite dans le magasin, vide en cas d'échec.
  key        String   @default("")
  /// Poids de l'instantané, en octets.
  bytes      Int      @default(0)
  /// Nombre d'instantanés supprimés par la rétention lors de ce passage.
  pruned     Int      @default(0)
  /// Message d'échec en français, sans trace d'exécution ni secret.
  detail     String   @default("")
  durationMs Int?
  /// Déclenché à la main depuis /reglages plutôt que par le planificateur.
  manual     Boolean  @default(false)

  @@index([startedAt])
  @@map("snapshot_runs")
}

/// La file du jour, figée au premier affichage.
///
/// Sans cette ligne, le dénominateur de l'anneau d'avancement reculerait à
/// chaque élément traité — la file rétrécit quand on travaille — et l'anneau
/// resterait éternellement au même endroit. `planned` fixe la taille du matin ;
/// il peut monter en cours de journée si de nouvelles échéances tombent, jamais
/// descendre.
model QueueDay {
  /// AAAA-MM-JJ, calculé sur le fuseau du serveur comme le reste du projet.
  day       String   @id
  planned   Int      @default(0)
  createdAt DateTime @default(now())

  @@map("queue_days")
}

/// Un élément de la file traité aujourd'hui.
///
/// Le compte se fait sur des lignes distinctes plutôt que sur un compteur
/// incrémenté : reporter deux fois la même relance est une seule ligne traitée,
/// et un compteur l'aurait comptée deux fois. La contrainte d'unicité porte la
/// règle, plutôt qu'un test applicatif qui perdrait aux écritures concurrentes.
model QueueMark {
  id String @id @default(cuid())
  /// Même clé que `QueueDay.day`.
  day String
  /// Identifiant de ligne de file : `reminder-<contact>`, `task-<id>`, `deal-<id>`.
  itemId String
  /// L'action qui a retiré la ligne, pour le journal. Sans valeur de calcul.
  action String   @default("")
  at     DateTime @default(now())

  @@unique([day, itemId])
  @@index([day])
  @@map("queue_marks")
}


/// Passage d'une affaire dans une étape.
///
/// `Deal.stageSince` ne dit que depuis quand l'affaire est dans son étape
/// **actuelle** : il ne permet pas de répondre à « où mes affaires stagnent-elles ? »,
/// qui demande la durée passée dans les étapes **quittées**. Une ligne est
/// écrite à chaque entrée, y compris à la création ; la durée d'un passage est
/// l'écart avec l'entrée suivante, ou avec maintenant pour la dernière.
///
/// Conséquence assumée : les affaires antérieures à cette table n'ont qu'une
/// seule visite, reconstituée depuis `stageSince`. Leur historique de passage
/// est perdu — il n'a jamais été enregistré — et les moyennes ne deviennent
/// vraies qu'à mesure que de nouveaux passages s'accumulent.
model DealStageVisit {
  id        String   @id @default(cuid())
  dealId    String
  stageId   String
  enteredAt DateTime @default(now())

  deal  Deal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  stage Stage @relation(fields: [stageId], references: [id])

  @@index([dealId, enteredAt])
  @@index([stageId])
  @@map("deal_stage_visits")
}

/// Les personnes qui peuvent signer un email.
///
/// Une table plutôt que deux colonnes : ils sont deux aujourd'hui, et le couple
/// « nom / titre » unique du jalon 34 ne savait en décrire qu'un. Le signataire
/// se choisit à la rédaction, message par message — ce n'est pas un réglage
/// global mais une propriété de l'envoi.
model Signatory {
  id    String @id @default(cuid())
  name  String
  title String @default("")
  /// Le signataire proposé quand rien d'autre ne tranche.
  isDefault Boolean @default(false)
  position  Int     @default(0)

  @@map("signatories")
}

/// Un email réellement parti.
///
/// **Distinct de l'interaction consignée**, qui reste la trace lisible dans la
/// chronologie. Cette table-ci porte les faits qu'on veut compter : quand, à
/// qui, sous quelle signature, avec quel `Message-ID`, la copie IMAP a-t-elle
/// abouti, et le jeton de suivi s'il y en a un. Compter depuis les interactions
/// aurait mélangé les envois avec les notes de correction et les appels — c'est
/// le piège du jalon 22, déjà payé une fois.
model EmailSend {
  id     String   @id @default(cuid())
  sentAt DateTime @default(now())

  contactId String?
  /// `SetNull` : supprimer une fiche ne doit pas effacer l'historique d'envoi,
  /// même règle qu'au jalon 3 pour les affaires et les interactions.
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  toAddress String
  subject   String
  /// Le corps tel qu'envoyé, pour pouvoir relire ce qu'on a écrit.
  body      String @default("")
  messageId String @default("")

  /// Qui signait. Le nom est **copié**, pas seulement référencé : un signataire
  /// renommé ou supprimé plus tard ne doit pas réécrire l'histoire.
  signatoryId   String @default("")
  signatoryName String @default("")

  /// Suivi d'ouverture. `tracked = false` quand l'expéditeur l'a coupé pour cet
  /// envoi ou globalement — auquel cas `trackToken` est nul et rien n'est mesuré.
  tracked     Boolean   @default(false)
  /// Jeton opaque du pixel. **C'est tout ce qu'on stocke du destinataire** :
  /// pas d'adresse IP, pas d'agent utilisateur, pas de profil.
  trackToken  String?   @unique
  firstOpenAt DateTime?
  lastOpenAt  DateTime?
  openCount   Int       @default(0)
  /// Vidé par la purge de rétention, sans supprimer l'envoi lui-même.
  purgedAt    DateTime?

  /// De quelle séquence vient ce message, et de quelle étape.
  ///
  /// **Le nom est copié, pas seulement référencé** : une séquence renommée ou
  /// supprimée plus tard ne doit pas réécrire l'histoire. Quand un prospect
  /// finit par répondre, il faut savoir à quoi il répond — et « séquence 2,
  /// étape 3 » ne se reconstitue pas après coup.
  sequenceId   String @default("")
  sequenceName String @default("")
  sequenceStep Int?

  /// copied | failed | disabled | unconfigured — l'état de la copie « Envoyés ».
  copyStatus String @default("disabled")
  /// L'erreur IMAP exacte, telle que le serveur l'a dite. Jamais d'identifiant.
  copyError  String @default("")

  @@index([sentAt])
  @@index([contactId])
  @@map("email_sends")
}

/// Une séquence d'emails — **distincte des séquences de tâches** du jalon 4.
///
/// Celles-ci envoient des messages ; celles-là créent des tâches à faire à la
/// main. Les fondre aurait produit un objet dont la moitié des champs n'aurait
/// eu de sens qu'une fois sur deux, et un écran qui aurait dû demander
/// « celle-ci envoie-t-elle vraiment ? » à chaque ligne.
model EmailSequence {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  /// Mode automatique : les étapes **à partir de la deuxième** partent sans
  /// validation. Il ne se déverrouille qu'à deux conditions, vérifiées au
  /// serveur et pas seulement à l'écran — voir `lib/domain/sequence-rules.ts`.
  autoMode Boolean @default(false)

  steps       EmailSequenceStep[]
  enrollments SequenceEnrollment[]

  @@map("email_sequences")
}

/// Trois étapes au maximum, et c'est une décision, pas une limite technique.
///
/// Une séquence qui s'arrête d'elle-même au bout de trois messages limite les
/// dégâts d'une réponse non détectée mieux que n'importe quel mécanisme.
model EmailSequenceStep {
  id         String @id @default(cuid())
  sequenceId String
  sequence   EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  /// 1, 2 ou 3.
  position Int
  /// Jours après l'étape précédente. L'étape 1 part le jour de l'inscription.
  delayDays Int @default(0)
  /// Ce qu'Alex doit faire de cette étape, en une phrase.
  brief String @default("")

  @@unique([sequenceId, position])
  @@map("email_sequence_steps")
}

/// L'inscription d'un contact à une séquence.
model SequenceEnrollment {
  id         String   @id @default(cuid())
  sequenceId String
  sequence   EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  /// active | done | stopped
  status String @default("active")
  /// Pourquoi elle s'est arrêtée, en français.
  ///
  /// **Une séquence qui s'arrête sans dire pourquoi ressemble à une panne.**
  stopReason String @default("")

  /// Dernière étape réellement envoyée. `0` = aucune.
  lastStep   Int       @default(0)
  lastSentAt DateTime?

  departures SequenceDeparture[]

  @@unique([sequenceId, contactId])
  @@index([status])
  @@map("sequence_enrollments")
}

/// Un départ proposé pour la file du matin.
///
/// **Composé le matin même, jamais la veille.** Un brouillon écrit vendredi soir
/// et envoyé lundi matin décrit l'état de vendredi : la réponse arrivée samedi
/// ne l'aurait pas arrêté. La file du lundi se construit lundi.
model SequenceDeparture {
  id           String   @id @default(cuid())
  enrollmentId String
  enrollment   SequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  step         Int
  createdAt    DateTime @default(now())
  /// Le jour pour lequel il a été composé, `YYYY-MM-DD`.
  day          String

  /// pending | sent | skipped | postponed | failed
  status  String @default("pending")
  subject String @default("")
  body    String @default("")

  /// Parti sans validation humaine — seulement possible en mode automatique,
  /// et jamais pour l'étape 1. C'est aussi le compteur qui déverrouille ce mode :
  /// on compte les départs validés **à la main**.
  auto Boolean @default(false)

  decidedAt DateTime?
  detail    String    @default("")

  @@unique([enrollmentId, step])
  @@index([day, status])
  @@map("sequence_departures")
}
